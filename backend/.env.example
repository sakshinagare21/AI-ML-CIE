# =======================================================
# MongoDB Configuration for AI Loan Assessment
# =======================================================

# 1. MongoDB Atlas (Cloud Database - Free Tier):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/loan_prediction_db?retryWrites=true&w=majority

# 2. Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017

# Paste your MongoDB connection string below:
MONGODB_URI=

# Optional: Database name (defaults to loan_prediction_db)
MONGODB_DB_NAME=loan_prediction_db
